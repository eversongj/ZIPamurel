#include "../GUI/ExtractDialogRes.h"

#define y 96

#define zoneX 100

CAPTION "AMUREL"
BEGIN
  MY_CONTROL_CHECKBOX ( "Integrar o AMUREL ao menu de contexto", IDX_SYSTEM_INTEGRATE_TO_MENU, m, m, xc)
  MY_CONTROL_CHECKBOX ( "(32 bits)", IDX_SYSTEM_INTEGRATE_TO_MENU_2, m, m + 14, xc)
  MY_CONTROL_CHECKBOX ( "Menu de contexto em &cascata", IDX_SYSTEM_CASCADED_MENU, m, m + 28, xc)
  MY_CONTROL_CHECKBOX ( "Exibir ícones no menu de contexto", IDX_SYSTEM_ICON_IN_MENU, m, m + 42, xc)
  MY_CONTROL_CHECKBOX ( "Eliminar repetição da pasta raiz", IDX_EXTRACT_ELIM_DUP, m, m + 56, xc)

  LTEXT    "Propagar fluxo Zone.Id:", IDT_SYSTEM_ZONE, m, m + 70, xc - zoneX, 8
  COMBOBOX  IDC_SYSTEM_ZONE, m + xc - zoneX, m + 70 - 2, zoneX, 50, MY_COMBO

  LTEXT    "Itens do menu de contexto:", IDT_SYSTEM_CONTEXT_MENU_ITEMS, m, m + 84, xc, 8
  CONTROL  "List", IDL_SYSTEM_OPTIONS, "SysListView32",
           LVS_REPORT | LVS_SINGLESEL | LVS_NOCOLUMNHEADER | WS_BORDER | WS_TABSTOP,
           m, m + y, xc, yc - y
END


STRINGTABLE
BEGIN
    IDT_ZONE_FOR_OFFICE "Para arquivos do Office"
END
