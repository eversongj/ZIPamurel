<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Product
      Id="*"
      UpgradeCode="{26183A38-9BDF-44F7-91A7-96378C2C3501}"
      Name="AMUREL ZIP"
      Language="1046"
      Version="26.5.6.0"
      Manufacturer="AMUREL">
    <Package
        InstallerVersion="200"
        Compressed="yes"
        InstallScope="perMachine"
        Platform="x64"
        Description="Gerenciador de arquivos AMUREL ZIP"
        Comments="Baseado no 7-Zip. Consulte os avisos de licença instalados com o programa." />
    <MajorUpgrade DowngradeErrorMessage="Já está instalada uma versão mais recente do AMUREL ZIP." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <Property Id="WIXUI_INSTALLDIR" Value="INSTALLFOLDER" />
    <Icon Id="AmurelZipIcon.exe" SourceFile="$(var.ProjectRoot)\CPP\7zip\Bundles\Fm\x64\7zFM.exe" />
    <Property Id="ARPPRODUCTICON" Value="AmurelZipIcon.exe" />

    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="DesktopFolder" Name="Desktop" />
      <Directory Id="ProgramFiles64Folder">
        <Directory Id="INSTALLFOLDER" Name="AMUREL ZIP">
          <Directory Id="DOCFOLDER" Name="Documentos" />
        </Directory>
      </Directory>
      <Directory Id="CommonProgramsFolder">
        <Directory Id="AMURELPROGRAMMENU" Name="AMUREL" />
      </Directory>
    </Directory>

    <Feature Id="Complete" Title="AMUREL ZIP" Description="Gerenciador de arquivos AMUREL ZIP." Level="1">
      <Component Id="ApplicationFiles" Directory="INSTALLFOLDER" Guid="{963C0F54-9D8F-42D9-BD35-80C9BCC560F0}" Win64="yes">
        <File Id="AmurelZipExecutable" Source="$(var.ProjectRoot)\CPP\7zip\Bundles\Fm\x64\7zFM.exe" KeyPath="yes">
          <Shortcut
              Id="AmurelZipDesktopShortcut"
              Directory="DesktopFolder"
              Name="AMUREL ZIP"
              Description="Abrir o gerenciador de arquivos AMUREL ZIP"
              WorkingDirectory="INSTALLFOLDER"
              Advertise="yes"
              Icon="AmurelZipIcon.exe"
              IconIndex="0" />
          <Shortcut
              Id="AmurelZipStartMenuShortcut"
              Directory="AMURELPROGRAMMENU"
              Name="AMUREL ZIP"
              Description="Abrir o gerenciador de arquivos AMUREL ZIP"
              WorkingDirectory="INSTALLFOLDER"
              Advertise="yes"
              Icon="AmurelZipIcon.exe"
              IconIndex="0" />
        </File>
        <File Id="AmurelZipGui" Source="$(var.ProjectRoot)\CPP\7zip\UI\GUI\x64\7zG.exe" />
        <File Id="AmurelZipCodecs" Source="$(var.ProjectRoot)\CPP\7zip\Bundles\Format7zF\x64\7z.dll" />
        <RemoveFolder Id="RemoveAmurelProgramMenu" Directory="AMURELPROGRAMMENU" On="uninstall" />
      </Component>

      <Component Id="ShellExtension" Directory="INSTALLFOLDER" Guid="{B3D3499C-04E5-4A99-8D66-BD737E4BBA8C}" Win64="yes">
        <File Id="AmurelExplorerExtension" Source="$(var.ProjectRoot)\CPP\7zip\UI\Explorer\x64\7-zip.dll" KeyPath="yes" />
        <RegistryKey Root="HKCR" Key="CLSID\{A7B3E5D2-6C48-4F91-9B72-13D0A54E2C86}">
          <RegistryValue Type="string" Value="AMUREL ZIP Shell Extension" />
          <RegistryKey Key="InprocServer32">
            <RegistryValue Type="string" Value="[INSTALLFOLDER]7-zip.dll" />
            <RegistryValue Name="ThreadingModel" Type="string" Value="Apartment" />
          </RegistryKey>
        </RegistryKey>
        <RegistryKey Root="HKLM" Key="Software\Microsoft\Windows\CurrentVersion\Shell Extensions\Approved">
          <RegistryValue Name="{A7B3E5D2-6C48-4F91-9B72-13D0A54E2C86}" Type="string" Value="AMUREL ZIP Shell Extension" />
        </RegistryKey>
        <RegistryKey Root="HKCR" Key="Directory\shellex\ContextMenuHandlers\AMUREL ZIP">
          <RegistryValue Type="string" Value="{A7B3E5D2-6C48-4F91-9B72-13D0A54E2C86}" />
        </RegistryKey>
        <RegistryKey Root="HKCR" Key="*\shellex\ContextMenuHandlers\AMUREL ZIP">
          <RegistryValue Type="string" Value="{A7B3E5D2-6C48-4F91-9B72-13D0A54E2C86}" />
        </RegistryKey>
        <RegistryKey Root="HKCR" Key="Folder\shellex\ContextMenuHandlers\AMUREL ZIP">
          <RegistryValue Type="string" Value="{A7B3E5D2-6C48-4F91-9B72-13D0A54E2C86}" />
        </RegistryKey>
        <RegistryKey Root="HKCR" Key="Directory\shell\AMURELZIP">
          <RegistryValue Type="string" Value="Compactar com AMUREL ZIP" />
          <RegistryValue Name="Icon" Type="string" Value="&quot;[INSTALLFOLDER]7zFM.exe&quot;" />
          <RegistryKey Key="command">
            <RegistryValue Type="string" Value="&quot;[INSTALLFOLDER]7zG.exe&quot; a -ad -tzip &quot;%1.zip&quot; &quot;%1&quot;" />
          </RegistryKey>
        </RegistryKey>
        <RegistryKey Root="HKCR" Key="*\shell\AMURELZIP">
          <RegistryValue Type="string" Value="Compactar com AMUREL ZIP" />
          <RegistryValue Name="Icon" Type="string" Value="&quot;[INSTALLFOLDER]7zFM.exe&quot;" />
          <RegistryKey Key="command">
            <RegistryValue Type="string" Value="&quot;[INSTALLFOLDER]7zG.exe&quot; a -ad -tzip &quot;%1.zip&quot; &quot;%1&quot;" />
          </RegistryKey>
        </RegistryKey>
      </Component>

      <Component Id="ExtractionContextMenu" Directory="INSTALLFOLDER" Guid="{17A620B1-17D2-48A0-8D60-D9733C87CA26}" Win64="yes">
        <RegistryKey Root="HKLM" Key="Software\Classes\SystemFileAssociations\.zip\shell\AMURELZIP.Extract">
          <RegistryValue Type="string" Value="Descompactar com AMUREL ZIP..." KeyPath="yes" />
          <RegistryValue Name="Icon" Type="string" Value="&quot;[INSTALLFOLDER]7zFM.exe&quot;" />
          <RegistryValue Name="MultiSelectModel" Type="string" Value="Single" />
          <RegistryKey Key="command">
            <RegistryValue Type="string" Value="&quot;[INSTALLFOLDER]7zG.exe&quot; x -ad -o&quot;%1-extraido&quot; -- &quot;%1&quot;" />
          </RegistryKey>
        </RegistryKey>
        <RegistryKey Root="HKLM" Key="Software\Classes\SystemFileAssociations\.7z\shell\AMURELZIP.Extract">
