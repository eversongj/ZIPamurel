      </Component>

      <Component Id="DocumentationFiles" Directory="DOCFOLDER" Guid="{D40B1D7F-99A5-4A69-AE19-21244203EC44}" Win64="yes">
        <File Id="AmurelGuide" Source="$(var.ProjectRoot)\DOC\Guia-Amurel-ZIP.md" KeyPath="yes" />
        <File Id="LicenseNotices" Source="$(var.ProjectRoot)\DOC\License.txt" />
        <File Id="UnRarLicense" Source="$(var.ProjectRoot)\DOC\unRarLicense.txt" />
      </Component>
    </Feature>

    <UIRef Id="WixUI_InstallDir" />
    <WixVariable Id="WixUILicenseRtf" Value="$(var.ProjectRoot)\DOC\AmurelLicense.rtf" />
